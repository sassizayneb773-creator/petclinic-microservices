{
  "name": "PetClinic Microservices",
  "image": "mcr.microsoft.com/devcontainers/java:17",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "installMaven": "true",
      "installGradle": "false"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "forwardPorts": [8080, 8761, 8888, 9090, 9411, 3030, 9091],
  "portsAttributes": {
    "8080": { "label": "PetClinic API Gateway", "onAutoForward": "openBrowser" },
    "8761": { "label": "Eureka Discovery" },
    "8888": { "label": "Config Server" },
    "9090": { "label": "Spring Boot Admin" },
    "9411": { "label": "Zipkin Tracing" },
    "3030": { "label": "Grafana" },
    "9091": { "label": "Prometheus" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vscjava.vscode-maven"
      ]
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  }
}
